{
  "name": "toolreader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "toolreader": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "plugins/codex-history",
    ".agents/plugins/marketplace.json"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && vp config --no-agent",
    "dev": "node --watch src/server/bin.ts serve & vp dev",
    "build": "vp build && vp build -c vite.site.config.ts && vp pack",
    "start": "vp run build && node dist/bin.mjs serve",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p src/web/tsconfig.json && tsgo --noEmit -p src/app/tsconfig.json",
    "app:dev": "vp dev -c vite.app.config.ts",
    "app:build": "vp build -c vite.app.config.ts",
    "export": "node src/server/bin.ts export",
    "history": "node src/server/bin.ts history",
    "prepack": "vp run build",
    "site:build": "vp build -c vite.site.config.ts && node scripts/site.ts"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/sql-pg": "4.0.0-beta.103",
    "@effect/tsgo": "0.13.2",
    "@effect/vitest": "4.0.0-beta.103",
    "@oxlint/plugins": "^1.86.0",
    "@pierre/diffs": "1.3.0-beta.10",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.61",
    "@types/node": "^24.12.4",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260604.1",
    "@vitejs/plugin-react": "^6.1.1",
    "aws4fetch": "1.0.20",
    "effect": "4.0.0-beta.103",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "0.2.2"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}

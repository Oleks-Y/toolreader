{
  "name": "toolreader",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch && vp config --no-agent",
    "dev": "node --watch src/server/bin.ts & vp dev",
    "build": "vp build",
    "start": "vp build && node src/server/bin.ts",
    "test": "vp test run",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p src/web/tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.103",
    "@pierre/diffs": "1.3.0-beta.10",
    "effect": "4.0.0-beta.103",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.13.2",
    "@effect/vitest": "4.0.0-beta.103",
    "@oxlint/plugins": "^1.86.0",
    "@types/node": "^24.12.4",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260604.1",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "0.2.2"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}
